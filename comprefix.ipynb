   "outputs": [],
   "source": [
    "def longestCommonPrefix(strs):\n",
    "    if not strs:\n",
    "        return \"\"\n",
    "\n",
    "    prefix = strs[0]\n",
    "\n",
    "    for word in strs[1:]:\n",
    "        while not word.startswith(prefix):\n",
    "            prefix = prefix[:-1]\n",
    "\n",
    "            if prefix == \"\":\n",
    "                return \"\"\n",
    "\n",
    "    return prefix"
   ]
