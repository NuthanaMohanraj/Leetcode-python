   "outputs": [],
   "source": [
    "\n",
    "class Solution:\n",
    "    def climbStairs(self, n: int) -> int:\n",
    "        if n <= 2:\n",
    "            return n\n",
    "\n",
    "        a = 1\n",
    "        b = 2\n",
    "\n",
    "        for i in range(3, n + 1):\n",
    "            c = a + b\n",
    "            a = b\n",
    "            b = c\n",
    "\n",
    "        return b\n"
   ]
  },
